{
  "name": "azgaar-genesis-fork",
  "version": "0.3.0",
  "description": "Modular JavaScript library fork of Azgaar's Fantasy Map Generator for Genesis Mythos integration",
  "type": "module",
  "main": "dist/azgaar-genesis.umd.js",
  "module": "dist/azgaar-genesis.esm.js",
  "scripts": {
    "build": "vite build && vite build --mode minified && node scripts/verify-bundle-exports.js",
    "build:dev": "vite build --mode development && node scripts/verify-bundle-exports.js",
    "build:prod": "vite build && node scripts/verify-bundle-exports.js",
    "build:min": "vite build --mode minified",
    "dev": "vite",
    "preview": "vite preview",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:launch": "npm run build:dev && vite --open examples/canvas-preview.html",
    "compare": "node scripts/compare-generators.js"
  },
  "keywords": [
    "fantasy",
    "map",
    "generator",
    "azgaar",
    "genesis-mythos"
  ],
  "author": "Lordthoth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/L0RDTH0TH/azgaar-genesis-fork.git"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "delaunator": "^5.0.1",
    "jest": "^29.7.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "d3-color": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0"
  },
  "peerDependencies": {
    "d3": "^7.0.0",
    "delaunator": "^5.0.0"
  }
}
